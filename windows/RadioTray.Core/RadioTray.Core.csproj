<Project Sdk="Microsoft.NET.Sdk">
  <!-- Logica senza interfaccia (stazioni, playlist, titoli, ICY): la usa l'app per Windows e la provano i test,
       che girano anche su Linux e sul runner Windows della CI. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>RadioTray</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
