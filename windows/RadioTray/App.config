<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <system.net>
    <!-- il proxy di Windows (anche con script PAC), con l'utente di dominio: come Edge e Chrome -->
    <defaultProxy enabled="true" useDefaultCredentials="true">
      <proxy usesystemdefault="true" />
    </defaultProxy>
    <settings>
      <!-- i vecchi server Shoutcast rispondono "ICY 200 OK" con intestazioni non proprio regolari -->
      <httpWebRequest useUnsafeHeaderParsing="true" />
    </settings>
  </system.net>
</configuration>
